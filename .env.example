# Nukopijuokite į .env.local. Niekada necommitinkite tikrų reikšmių.
# Kintamieji BE NEXT_PUBLIC_ prefikso pasiekiami tik serveryje (API routes / Server Actions).
# Į NEXT_PUBLIC_ kintamuosius niekada nedėkite slaptų raktų – jie patenka į naršyklės bundle.

# Viešas svetainės adresas (naudojamas metaduomenims)
NEXT_PUBLIC_SITE_URL=https://example.lt

# --- Būsimos integracijos (šiame etape nenaudojamos) ---
# Kalendoriaus / registracijos integracija (serverio pusėje)
# BOOKING_API_KEY=
# Laiškų siuntimas kontaktų formai (serverio pusėje)
# EMAIL_PROVIDER_API_KEY=
# CONTACT_INBOX=
# Mokėjimai (serverio pusėje; publishable raktas galės būti NEXT_PUBLIC_)
# PAYMENTS_SECRET_KEY=
